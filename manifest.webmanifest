{
  "name": "Dr. Mrinal Duty App",
  "short_name": "Duty App",
  "description": "Monthly hospital duty roster for Dr. Mrinal — PICU, NICU, ER and OPD schedules.",
  "id": "duty-roster",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fcfbfa",
  "theme_color": "#5B93D8",
  "lang": "en",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today's Duty",
      "short_name": "Today",
      "description": "Jump straight to today's roster card",
      "url": "./index.html?view=daily",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Monthly Calendar",
      "short_name": "Month",
      "description": "See the full month at a glance",
      "url": "./index.html?view=month",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Add Note",
      "short_name": "Note",
      "description": "Quickly add a note for today",
      "url": "./index.html?action=note",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}